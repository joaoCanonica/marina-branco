{
  "name": "marina-branco",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "node scripts/prepare-media.mjs && astro dev",
    "check": "node scripts/validate-config.ts --resumo && astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build": "node scripts/validate-config.ts --resumo && node scripts/prepare-media.mjs && astro build && node scripts/gerar-csp.ts",
    "preview": "astro preview",
    "midia:derivar": "node scripts/derivar-midia.ts",
    "midia:hash": "node scripts/hash-original.ts",
    "media": "node scripts/prepare-media.mjs",
    "midia:ocr": "node scripts/ocr-midia.mjs",
    "midia:inventario": "node scripts/inventario-midia.mjs",
    "midia:pendencias": "node scripts/pendencias-midia.mjs",
    "validate": "node scripts/validate-config.ts",
    "validate:prod": "node scripts/validate-config.ts --production",
    "pendencias": "node scripts/pendencias.ts",
    "impressos": "node scripts/impressos.ts",
    "og": "node scripts/og.ts",
    "schema:validar": "node scripts/validar-schema.ts",
    "audit:compliance": "node scripts/audit-compliance.ts",
    "audit:a11y": "node scripts/audit-a11y.ts",
    "audit:orcamento": "node scripts/audit-orcamento.ts",
    "audit:lighthouse": "node scripts/audit-lighthouse.ts",
    "csp": "node scripts/gerar-csp.ts",
    "auditar": "pnpm audit:compliance && pnpm audit:orcamento && pnpm audit:a11y"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "astro": "^7.3.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tesseract.js-data/por": "^1.0.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "1.5.6",
    "axe-core": "4.11.0",
    "playwright-core": "1.56.1",
    "potrace": "^2.1.8",
    "qrcode": "1.5.4",
    "schema-dts": "1.1.5",
    "tesseract.js": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
