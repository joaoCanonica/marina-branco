---
/**
 * Contato: como agendar (3 passos), primeira avaliação, formulário opcional
 * e as unidades (Lages principal; seção de Balneário Camboriú). Uma página só,
 * sem páginas-doorway. Mapa estático, sem iframe nem tiles de terceiros.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/base/Section.astro';
import Container from '../components/base/Container.astro';
import Eyebrow from '../components/base/Eyebrow.astro';
import ComoAgendar from '../components/agendamento/ComoAgendar.astro';
import PrimeiraAvaliacao from '../components/agendamento/PrimeiraAvaliacao.astro';
import FormContato from '../components/agendamento/FormContato.astro';
import CartaoUnidade from '../components/agendamento/CartaoUnidade.astro';
import { site } from '../lib/site.ts';
import { schemaClinica } from '../lib/schema.ts';

const { profile } = site;
const principal = profile.unidades.find((u) => u.fixa) ?? profile.unidades[0]!;
const outras = profile.unidades.filter((u) => u !== principal);
const tel = site.telefoneUrl();
const schema = schemaClinica(profile, Astro.site ? new URL('/', Astro.site).href : profile.dominio);
---
<Base titulo="Contato" tituloSeo={`Agendamento e endereço em ${profile.unidades.map((u) => u.cidade).join(' e ')} · ${profile.nomeClinica}`} trilha={[{ nome: 'Contato', caminho: '/contato' }]} descricao={`Como agendar, primeira avaliação, endereço e horários em ${profile.unidades.map((u) => u.cidade).join(' e ')}.`} tomCabecalho="marfim">
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />}
  <Section tone="marfim">
    <Container>
      <div class="grade">
        <div>
          <h1 class="sr">Contato</h1>
          <ComoAgendar />
          {tel && <p class="num">Ou ligue: <a href={tel}>{profile.telefone}</a></p>}
        </div>
        <FormContato />
      </div>
    </Container>
  </Section>
  <Section tone="nude">
    <Container><PrimeiraAvaliacao /></Container>
  </Section>
  <Section tone="marfim">
    <Container>
      <Eyebrow>Onde estamos</Eyebrow>
      <CartaoUnidade u={principal} titulo={`${principal.cidade} – ${principal.uf}`} />
      {outras.map((u) => <CartaoUnidade u={u} titulo={`Atendimento em ${u.cidade}`} />)}
    </Container>
  </Section>
</Base>
<style>
  .grade { display: grid; gap: 3rem; grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr)); align-items: start; }
</style>
