---
import Base from '../layouts/Base.astro';
import Section from '../components/base/Section.astro';
import Container from '../components/base/Container.astro';
import Eyebrow from '../components/base/Eyebrow.astro';
import ListaServicos from '../components/ListaServicos.astro';
import ComoAgendar from '../components/agendamento/ComoAgendar.astro';
import Hero from '../components/assinatura/Hero.astro';
import { site } from '../lib/site.ts';
import { schemaClinica } from '../lib/schema.ts';
const { profile } = site;
const sede = profile.unidades.find((u) => u.fixa) ?? profile.unidades[0]!;
const schema = schemaClinica(profile, Astro.site ? new URL('/', Astro.site).href : profile.dominio);
---
<Base titulo={profile.nomeClinica} descricao={`Clínica de estética em ${sede.cidade} – ${sede.uf}. Procedimentos indicados após avaliação individual.`} tomCabecalho="preto" intro tituloSeo={`${profile.nomeClinica} · Clínica de estética em ${sede.cidade} – ${sede.uf}`}>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />}
  <Hero />

  <Section tone="marfim" curva={{ lado: 'esquerda' }}>
    <Container class="principios">
      <div>
        <Eyebrow>Como trabalhamos</Eyebrow>
        <h2>Antes de qualquer procedimento, avaliação.</h2>
      </div>
      <ol role="list">
        <li data-revelar><h3>Avaliação individual</h3><p>Conversa sobre histórico, expectativas e contraindicações. Nem toda avaliação termina em procedimento.</p></li>
        <li data-revelar><h3>Profissional habilitada</h3><p>Cada serviço informa quem o realiza, a formação e o registro no conselho, quando houver.</p></li>
        <li data-revelar><h3>Informação clara</h3><p>Explicamos riscos, cuidados e o que a evidência disponível diz — inclusive quando ela é limitada.</p></li>
      </ol>
    </Container>
  </Section>

  <Section tone="nude" curva={{ lado: 'direita', final: true }}>
    <Container>
      <Eyebrow>Serviços</Eyebrow>
      <h2>O que realizamos</h2>
      <ListaServicos />
    </Container>
  </Section>
  <Section tone="marfim">
    <Container largura="texto"><ComoAgendar /></Container>
  </Section>
</Base>
<style>
  .principios { display: grid; gap: 3rem; grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr)); }
  ol { list-style: none; padding: 0; margin: 0; counter-reset: p; display: grid; gap: 2.5rem; }
  ol li { counter-increment: p; padding-inline-start: 4rem; position: relative; }
  ol li::before { content: '0' counter(p); position: absolute; inset-inline-start: 0; top: 0.1rem; font: 400 var(--texto-xl) / 1 var(--fonte-display); color: var(--cor-destaque); font-variant-numeric: lining-nums; }
  ol h3 { font-size: var(--texto-lg); }
</style>
