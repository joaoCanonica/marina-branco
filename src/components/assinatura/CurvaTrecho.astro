---
/**
 * "A Curva" — trecho de uma seção. Os trechos de seções vizinhas se emendam
 * numa linha dourada única: desce pela margem de um lado (fora do texto) e, na
 * folga entre seções, cruza a página com o desenho da curva do letreiro, para
 * continuar na margem oposta da seção seguinte.
 *  - scroll-driven (animation-timeline: view()) quando suportado;
 *  - fallback: IntersectionObserver adiciona .curva-trecho--visivel;
 *  - prefers-reduced-motion: estática e completa. Decorativa (aria-hidden).
 */
interface Props { lado: 'esquerda' | 'direita'; final?: boolean; inicio?: boolean }
const { lado, final = false, inicio = false } = Astro.props;
// Varredura em viewBox 0 0 100 100 (esticado): sai da margem de `lado` e chega à oposta.
const d = lado === 'direita' ? 'M100 0 C100 58 0 38 0 100' : 'M0 0 C0 58 100 38 100 100';
---
<div class:list={['curva-trecho', `curva-trecho--${lado}`, { 'curva-trecho--final': final, 'curva-trecho--inicio': inicio }]} aria-hidden="true" data-curva-trecho>
  <span class="curva-trecho__fio" />
  {!final && <svg class="curva-trecho__varre" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><path d={d} /></svg>}
  {final && <span class="curva-trecho__ponto" />}
</div>
<script>
  const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduzido && !CSS.supports('animation-timeline: view()') && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('curva-io');
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('curva-trecho--visivel'); io.unobserve(e.target); }
    }, { threshold: 0.2 });
    document.querySelectorAll('[data-curva-trecho]').forEach((el) => io.observe(el));
  }
</script>
<style>
  .curva-trecho {
    --margem: max(0.5rem, calc((100% - var(--medida)) / 4));
    --faixa: clamp(3rem, 2rem + 4vw, 6.5rem);
    position: absolute; inset: 0; z-index: 1; pointer-events: none; color: var(--cor-assinatura);
    view-timeline-name: --trecho;
  }
  .curva-trecho__fio { position: absolute; inset-block: 0 var(--faixa); inline-size: 1px; background: currentColor; transform-origin: top; }
  .curva-trecho--inicio .curva-trecho__fio { inset-block-start: 35%; }
  .curva-trecho--direita .curva-trecho__fio { inset-inline-end: var(--margem); }
  .curva-trecho--esquerda .curva-trecho__fio { inset-inline-start: var(--margem); }
  .curva-trecho--final .curva-trecho__fio { inset-block-end: 40%; }
  .curva-trecho__varre { position: absolute; inset-block-end: 0; inset-inline: var(--margem); block-size: var(--faixa); inline-size: calc(100% - 2 * var(--margem)); overflow: visible; }
  .curva-trecho__varre path { fill: none; stroke: currentColor; stroke-width: 1.25; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .curva-trecho__ponto { position: absolute; inset-block-end: calc(40% - 0.3rem); inline-size: 0.55rem; block-size: 0.55rem; background: currentColor; transform: translateX(-50%) rotate(45deg); }
  .curva-trecho--direita .curva-trecho__ponto { inset-inline-end: calc(var(--margem) - 0.28rem); transform: rotate(45deg); }
  .curva-trecho--esquerda .curva-trecho__ponto { inset-inline-start: calc(var(--margem) - 0.28rem); transform: rotate(45deg); }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .curva-trecho__fio { animation: curva-fio linear both; animation-timeline: --trecho; animation-range: entry 10% cover 60%; }
      .curva-trecho__varre path { animation: curva-varre linear both; animation-timeline: --trecho; animation-range: cover 45% exit 60%; }
    }
    :global(.curva-io) .curva-trecho__fio { transform: scaleY(0); transition: transform 1.6s var(--curva-entrada); }
    :global(.curva-io) .curva-trecho__varre path { stroke-dasharray: 4000; stroke-dashoffset: 4000; transition: stroke-dashoffset 1.2s var(--curva-padrao) 1.2s; }
    :global(.curva-io) .curva-trecho--visivel .curva-trecho__fio { transform: none; }
    :global(.curva-io) .curva-trecho--visivel .curva-trecho__varre path { stroke-dashoffset: 0; }
  }
  @keyframes curva-fio { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  /* non-scaling-stroke: o traço é medido em px de tela (pathLength é ignorado). */
  @keyframes curva-varre { from { stroke-dasharray: 4000; stroke-dashoffset: 4000; } to { stroke-dasharray: 4000; stroke-dashoffset: 0; } }
</style>
