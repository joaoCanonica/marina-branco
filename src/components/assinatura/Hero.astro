---
/**
 * Hero minimalista. O <h1> é o LCP. Lado visual: foto da responsável quando
 * gerada para o ambiente (publicável, ou previewOk em preview protegido);
 * sem foto, um quadro discreto com o monograma e as unidades.
 */
import Section from '../base/Section.astro';
import Container from '../base/Container.astro';
import Eyebrow from '../base/Eyebrow.astro';
import Button from '../base/Button.astro';
import MediaFrame from '../base/MediaFrame.astro';
import Monograma from './Monograma.astro';
import NomeProfissional from '../NomeProfissional.astro';
import { copy } from '../../config/copy.config.ts';
import { site, identificacao } from '../../lib/site.ts';

const { hero } = copy;
const wa = site.whatsappUrl(copy.whatsappMensagem);
const rt = site.responsavel();
const indices = import.meta.glob<{ itens: Record<string, unknown> }>('/src/assets/media/index.json', { eager: true, import: 'default' });
const fotoId = rt.fotoId && Object.values(indices)[0]?.itens[rt.fotoId] ? rt.fotoId : undefined;
const [antes, depois] = hero.titulo.includes(hero.destaque) ? hero.titulo.split(hero.destaque) : [hero.titulo, ''];
---
<Section tone="preto" class="hero" espaco="nenhum">
  <Container class="hero__grade">
    <div class="hero__texto">
      <Eyebrow>{hero.eyebrow}</Eyebrow>
      <h1>{antes}{depois !== '' || hero.titulo.includes(hero.destaque) ? <em>{hero.destaque}</em> : null}{depois}</h1>
      <p class="hero__apoio">{hero.apoio}</p>
      <div class="hero__acoes">
        {wa && <Button href={wa} externo icone="seta">{hero.ctaPrimario}</Button>}
        <Button href="/procedimentos" variante="secundario">{hero.ctaSecundario}</Button>
      </div>
      {wa && <p class="hero__aviso">{copy.avisoWhatsapp}</p>}
    </div>
    <div class="hero__visual">
      {fotoId ? (
        <MediaFrame proporcao="4/5" midiaId={fotoId} sizes="(min-width: 64rem) 40vw, 100vw" />
      ) : (
        <div class="hero__quadro">
          <Monograma class="hero__mono" />
          <dl class="hero__dados">
            {site.profile.unidades.map((u) => (<div><dt>{u.cidade} – {u.uf}</dt><dd>{u.fixa ? 'Clínica' : 'Atendimento'}</dd></div>))}
            <div><dt>Responsável</dt><dd><NomeProfissional p={rt} /></dd></div>
          </dl>
          <p class="hero__id">{identificacao(rt)}</p>
        </div>
      )}
    </div>
  </Container>
</Section>
<style>
  :global(.hero) { min-block-size: min(88svh, 48rem); display: grid; align-items: center; padding-block: clamp(3rem, 2rem + 5vw, 6rem); }
  :global(.hero .hero__grade) { display: grid; gap: clamp(2.5rem, 2rem + 3vw, 5rem); grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 64rem) { :global(.hero .hero__grade) { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }
  h1 { font-size: clamp(2.4rem, 1.6rem + 3.6vw, 4.4rem); max-inline-size: 18ch; margin-block-end: 0.5em; }
  h1 em { font-style: normal; color: var(--cor-destaque-texto); }
  .hero__apoio { font-size: var(--texto-lg); color: var(--cor-texto-suave); }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 2rem 0.75rem; }
  .hero__aviso { font-size: var(--texto-xs); color: var(--cor-texto-suave); max-inline-size: 36rem; }
  .hero__quadro { border: 1px solid var(--cor-borda); padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); display: grid; gap: 2rem; }
  :global(.hero__mono) { inline-size: 5rem; block-size: auto; }
  .hero__dados { margin: 0; display: grid; gap: 1rem; }
  .hero__dados div { display: flex; justify-content: space-between; gap: 1rem; border-block-end: 1px solid var(--cor-borda); padding-block-end: 0.75rem; }
  .hero__dados dt { font-weight: 500; }
  .hero__dados dd { margin: 0; color: var(--cor-texto-suave); text-align: end; }
  .hero__id { margin: 0; font-size: var(--texto-sm); color: var(--cor-texto-suave); }
</style>
