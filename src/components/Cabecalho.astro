---
import { site } from '../lib/site.ts';
const links = [
  { href: '/', rotulo: 'Início' },
  { href: '/servicos', rotulo: 'Serviços' },
  { href: '/equipe', rotulo: 'Equipe' },
];
const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
const wa = site.whatsappUrl();
---
<header class="cabecalho escuro">
  <div class="medida barra">
    <a href="/" class="marca" aria-label={`${site.clinica.nome}, página inicial`}>
      <span class="marca-nome">Marina Branco</span>
      <span class="marca-sub">Clínica de Estética</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={atual === l.href ? 'page' : undefined}>{l.rotulo}</a></li>
        ))}
        {wa && <li><a class="botao" href={wa} rel="noopener">Agendar avaliação</a></li>}
      </ul>
    </nav>
  </div>
</header>
<style>
  .cabecalho { border-bottom: 1px solid rgb(196 164 104 / 0.35); }
  .barra { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; justify-content: space-between; padding-block: 1.25rem; }
  .marca { text-decoration: none; display: grid; line-height: 1; }
  .marca-nome { font: 500 1.75rem/1 var(--serif); letter-spacing: 0.04em; }
  .marca-sub { font: 600 0.65rem/1.6 var(--sans); letter-spacing: 0.32em; text-transform: uppercase; color: var(--ouro); }
  ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; align-items: center; list-style: none; margin: 0; padding: 0; }
  nav a:not(.botao) { display: inline-block; padding-block: 0.75rem; font-size: 0.9rem; text-decoration: none; }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--ouro); }
  .botao { padding: 0.75rem 1.25rem; }
</style>
