---
/**
 * Única forma de exibir imagem de conteúdo. Usa o arquivo derivado (nunca o
 * original) e marca provisórias com selo visível.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../lib/site.ts';

interface Props { id: string; sizes?: string; class?: string }
const { id, sizes = '100vw', class: classe } = Astro.props;
const m = site.midia(id);
const arquivos = import.meta.glob<{ default: ImageMetadata }>('/midia/derivados/*.{jpg,jpeg,png,webp,avif}');
const chave = `/midia/derivados/${m.derivado ?? ''}`;
const carregar = arquivos[chave];
if (!carregar) throw new Error(`mídia ${id}: derivado ${chave} não encontrado (rode pnpm midia:derivar)`);
const src = (await carregar()).default;
---
<figure class:list={['midia', classe]} data-provisoria={m.provisoria ? '' : undefined}>
  <Image src={src} alt={m.alt} sizes={sizes} widths={[480, 800, 1200, 1600]} />
  {m.provisoria && <span class="selo">Provisório</span>}
</figure>
<style>
  .midia { position: relative; margin: 0; }
  .selo {
    position: absolute; top: 0.75rem; left: 0.75rem; padding: 0.35rem 0.6rem;
    background: #b00020; color: #fff; font: 700 0.75rem/1 var(--sans); letter-spacing: 0.15em; text-transform: uppercase;
  }
</style>
