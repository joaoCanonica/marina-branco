---
import Card from './base/Card.astro';
import Tag from './base/Tag.astro';
import Link from './base/Link.astro';
import { site, identificacao } from '../lib/site.ts';
import NomeProfissional from './NomeProfissional.astro';
---
{site.servicos.length === 0 ? (
  <p class="vazio">Os serviços serão apresentados aqui assim que cada um tiver profissional habilitada e informações conferidas.</p>
) : (
  <ul class="lista" role="list">
    {site.servicos.map((s) => {
      const p = site.membro(s.executor);
      return (
        <Card as="li">
          <Tag>{site.categoria(s).rotulo}</Tag>
          <h3>{s.nome}</h3>
          <p>{s.resumo}</p>
          <p class="exec">Realizado por <NomeProfissional p={p} /> · {identificacao(p)}</p>
          {s.paginaPropria && <Link href={s.rota} variante="seta">Saiba mais</Link>}
        </Card>
      );
    })}
  </ul>
)}
<style>
  .lista { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); }
  .exec { font-size: var(--texto-sm); }
  .vazio { color: var(--cor-texto-suave); border-inline-start: 1px solid var(--cor-destaque); padding-inline-start: 1rem; }
</style>
