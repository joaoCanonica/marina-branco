---
import Eyebrow from '../base/Eyebrow.astro';
import Button from '../base/Button.astro';
import { copy } from '../../config/copy.config.ts';
import { site } from '../../lib/site.ts';
interface Props { nivel?: 2 | 3 }
const { nivel = 2 } = Astro.props;
const H = `h${nivel}` as 'h2' | 'h3';
const wa = site.whatsappUrl(copy.whatsappMensagem);
---
<div class="agendar">
  <Eyebrow>Agendamento</Eyebrow>
  <H>{copy.comoAgendar.titulo}</H>
  <ol class="passos" role="list">
    {copy.comoAgendar.passos.map((p, i) => (
      <li><span class="n" aria-hidden="true">{i + 1}</span><div><strong>{p.titulo}</strong><p>{p.texto}</p></div></li>
    ))}
  </ol>
  {wa && <Button href={wa} externo icone="seta">Chamar no WhatsApp</Button>}
  <p class="aviso-legal">{copy.avisoWhatsapp}</p>
</div>
<style>
  .passos { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: 1.25rem; }
  .passos li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; align-items: start; }
  .n { display: grid; place-items: center; inline-size: 2.5rem; block-size: 2.5rem; border: 1px solid var(--cor-destaque); border-radius: 50%; font: 400 var(--texto-lg) / 1 var(--fonte-display); color: var(--cor-destaque-texto); font-variant-numeric: lining-nums; }
  .passos p { margin: 0.25rem 0 0; color: var(--cor-texto-suave); }
</style>
