---
import type { Profissional } from '../lib/esquemas.ts';
interface Props { p: Profissional }
const { p } = Astro.props;
// Título só com confirmação; o marcador permite ao linter do HTML final distinguir.
const titulo = p.titulo && p.tituloConfirmado ? p.titulo : undefined;
---
{titulo && <><span data-titulo-confirmado>{titulo}</span>{' '}</>}{p.nomeExibicao}
