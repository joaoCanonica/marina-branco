---
import type { Membro } from '../lib/esquemas.ts';
import { tratamentoExibivel } from '../lib/site.ts';
interface Props { p: Membro }
const { p } = Astro.props;
// Tratamento só se o perfil do conselho comportar; o marcador permite ao linter do HTML distinguir.
const tratamento = tratamentoExibivel(p);
---
{tratamento && <><span data-titulo-confirmado>{tratamento}</span>{' '}</>}{p.nome}
