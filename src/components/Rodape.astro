---
import Container from './base/Container.astro';
import Divider from './base/Divider.astro';
import { site, identificacao, exibivel } from '../lib/site.ts';
import NomeProfissional from './NomeProfissional.astro';
const { profile, avisos } = site;
const rt = site.responsavel();
// Único acesso à rota reservada: link discreto, só se a página existir.
const temReservado = site.servicosReservados.some((s) => s.paginaPropria);
---
<footer class="rodape" data-tone="preto">
  <Container>
    <p class="nome">{profile.nomeClinica}</p>
    <Divider variante="curva" />
    <div class="grade">
      {profile.unidades.map((u) => (
        <div>
          <p class="cidade">{u.cidade} – {u.uf}</p>
          {exibivel(u.endereco) && <p>{u.endereco}</p>}
          {exibivel(u.dias) && <p class="num">{u.dias}</p>}
        </div>
      ))}
      <div class="legal">
        <p>Responsável técnica: <NomeProfissional p={rt} />{exibivel(identificacao(rt)) && ` — ${identificacao(rt)}`}</p>
        {exibivel(profile.cnpj) && <p class="num">CNPJ {profile.cnpj}</p>}
        {exibivel(profile.alvaraSanitario) && <p class="num">Alvará sanitário {profile.alvaraSanitario}</p>}
        {exibivel(profile.telefone) && <p class="num">Telefone {profile.telefone}</p>}
        <p>{avisos.resultado}</p>
        <p><a href="/privacidade">Privacidade</a> · <a href="/termos">Termos de uso</a> · <button type="button" class="reabrir" data-reabrir-cookies>Preferências de cookies</button></p>
        {temReservado && <p><a href={site.rotaReservada} rel="nofollow" data-link-reservado>Atendimento reservado</a></p>}
      </div>
    </div>
  </Container>
</footer>
<style>
  .rodape { padding-block: 4rem 3rem; border-top: 1px solid var(--cor-borda); }
  .nome { font: 400 var(--texto-xl) / 1.1 var(--fonte-display); margin: 0; }
  .grade { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); }
  .cidade { font-weight: 600; color: var(--cor-destaque-texto); }
  .legal { font-size: var(--texto-sm); color: var(--cor-texto-suave); }
  p { margin: 0 0 0.5em; }
  .reabrir { background: none; border: 0; padding: 0; min-block-size: 24px; color: inherit; font: inherit; text-decoration: underline; text-underline-offset: 0.22em; cursor: pointer; }
</style>
