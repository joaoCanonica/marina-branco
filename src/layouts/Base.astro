---
import '../styles/global.css';
import Revelar from '../components/Revelar.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import Consentimento from '../components/Consentimento.astro';
import BarraContato from '../components/agendamento/BarraContato.astro';
import { cssTokens } from '../styles/tokens.ts';
import Intro from '../components/assinatura/Intro.astro';
import { introBoot } from '../components/assinatura/introBoot.ts';
import { schemaTrilha } from '../lib/schema.ts';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import bodoniLatin from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';
import bodoniItalicoLatin from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-italic.woff2?url';
import { site } from '../lib/site.ts';
import type { NomeTom } from '../config/theme.config.ts';

interface Props { titulo: string; descricao: string; noindex?: boolean; tomCabecalho?: NomeTom; intro?: boolean; reservado?: boolean;
  /** Trilha para BreadcrumbList (sem a home). */
  trilha?: { nome: string; caminho: string }[];
  /** Título completo para buscadores; padrão: "<titulo> · <clínica>". */
  tituloSeo?: string | undefined;
  tipoOg?: 'website' | 'article';
}
const { titulo, descricao, noindex = false, tomCabecalho, intro = false, reservado = false, trilha = [], tituloSeo, tipoOg = 'website' } = Astro.props;
const { profile, ambiente, avisos } = site;
const tituloCompleto = tituloSeo ?? (titulo === profile.nomeClinica ? titulo : `${titulo} · ${profile.nomeClinica}`);
const urlAbs = (c: string) => (Astro.site ? new URL(c, Astro.site).href : c);
const ogImagem = urlAbs('/og.png');
const breadcrumb = !reservado && trilha.length
  ? schemaTrilha([{ nome: 'Início', url: urlAbs('/') }, ...trilha.map((t) => ({ nome: t.nome, url: urlAbs(t.caminho) }))])
  : null;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {!reservado && (
      <>
        <meta property="og:type" content={tipoOg} />
        <meta property="og:title" content={tituloCompleto} />
        <meta property="og:description" content={descricao} />
        <meta property="og:image" content={ogImagem} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:site_name" content={profile.nomeClinica} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
    {(!ambiente.producao || noindex) && <meta name="robots" content={reservado ? 'noindex, nofollow, noarchive, nosnippet' : 'noindex, nofollow'} />}
    {reservado && <meta name="referrer" content="no-referrer" />}
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodoniLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodoniItalicoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && !reservado && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <style is:inline set:html={cssTokens} />
    {intro && <script is:inline set:html={introBoot} />}
    <slot name="head" />
  </head>
  <body data-tone="marfim">
    {intro && <Intro />}
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    {!ambiente.producao && (
      <aside class="faixa-ambiente" aria-label="Aviso de versão">{avisos.faixaRevisao} ({ambiente.siteEnv})</aside>
    )}
    <Cabecalho tomInicial={tomCabecalho} />
    <main id="conteudo" tabindex="-1"><slot /></main>
    <Rodape />
    {!reservado && <BarraContato />}
    <Consentimento />
    <Revelar />
  </body>
</html>
<style>
  .faixa-ambiente { background: var(--cor-alerta); color: var(--cor-alerta-texto); text-align: center; padding: 0.4rem 1rem; font-size: var(--texto-sm); }
  main:focus { outline: none; }
</style>
